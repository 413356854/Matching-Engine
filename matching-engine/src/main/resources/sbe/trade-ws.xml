<?xml version="1.0" encoding="UTF-8"?>
<sbe:messageSchema xmlns:sbe="http://fixprotocol.io/2016/sbe"
                   package="com.me.websocket.trading.sbe"
                   id="1"
                   version="0"
                   semanticVersion="1.0"
                   description="WebSocket trade binary protocol">
    <types>
        <composite name="messageHeader" description="Message header">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="templateId" primitiveType="uint16"/>
            <type name="schemaId" primitiveType="uint16"/>
            <type name="version" primitiveType="uint16"/>
        </composite>
        <composite name="varDataEncoding" description="Variable length UTF-8 data">
            <type name="length" primitiveType="uint16"/>
            <type name="varData" primitiveType="uint8" length="0" characterEncoding="UTF-8"/>
        </composite>
        <composite name="groupSizeEncoding" description="Repeating group dimensions">
            <type name="blockLength" primitiveType="uint16"/>
            <type name="numInGroup" primitiveType="uint16"/>
        </composite>
        <enum name="action" encodingType="uint8">
            <validValue name="PLACE">1</validValue>
            <validValue name="CANCEL">2</validValue>
        </enum>
        <enum name="side" encodingType="uint8">
            <validValue name="BUY">1</validValue>
            <validValue name="SELL">2</validValue>
        </enum>
        <enum name="orderType" encodingType="uint8">
            <validValue name="LIMIT">1</validValue>
            <validValue name="MARKET">2</validValue>
        </enum>
    </types>

    <sbe:message name="Login" id="10">
        <field name="userId" id="1" type="int64"/>
    </sbe:message>

    <sbe:message name="LoginAck" id="11">
        <field name="userId" id="1" type="int64"/>
        <field name="success" id="2" type="uint8"/>
        <data name="reason" id="3" type="varDataEncoding"/>
    </sbe:message>

    <sbe:message name="Order" id="20">
        <field name="action" id="1" type="action"/>
        <field name="side" id="2" type="side"/>
        <field name="orderType" id="3" type="orderType"/>
        <field name="price" id="4" type="int64"/>
        <field name="quantity" id="5" type="int64"/>
        <field name="amount" id="6" type="int64"/>
        <field name="orderId" id="7" type="int64"/>
        <data name="requestId" id="8" type="varDataEncoding"/>
        <data name="symbol" id="9" type="varDataEncoding"/>
    </sbe:message>

    <!-- 同一连接的一批 ingress ack 合成一个二进制帧；orderId=0 表示无委托号。 -->
    <sbe:message name="AckBatch" id="30">
        <group name="acks" id="1" dimensionType="groupSizeEncoding">
            <field name="success" id="1" type="uint8"/>
            <field name="orderId" id="2" type="int64"/>
            <data name="requestId" id="3" type="varDataEncoding"/>
            <data name="reason" id="4" type="varDataEncoding"/>
        </group>
    </sbe:message>

    <!-- WS 层 / 传输层错误；requestId 为空表示与具体请求无关。 -->
    <sbe:message name="Error" id="40">
        <data name="requestId" id="1" type="varDataEncoding"/>
        <data name="reason" id="2" type="varDataEncoding"/>
    </sbe:message>

    <!-- 等待 ingress ack 超时；客户端应查单，不能自动重试。 -->
    <sbe:message name="AckTimeout" id="41">
        <data name="requestId" id="1" type="varDataEncoding"/>
    </sbe:message>

    <sbe:message name="Ping" id="42"/>

    <sbe:message name="Pong" id="43"/>
</sbe:messageSchema>
