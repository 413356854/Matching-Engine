# 构建产物
**/target/
web/node_modules/
web/dist/
loadtest/out/

# 压测中间文件：临时压测脚本、编译类与测试报告（.log 由下方 *.log 覆盖）
loadtest/*.java
loadtest/*.class
loadtest/*.ps1
loadtest/*-window.txt
loadtest/TEST-REPORT*.md
# 汇总报告需要保留在仓库中
!loadtest/TEST-REPORT.md

# 本地脚本
*.ps1

# IDE
.idea/
*.iml

# 日志与调试产物
*.log
.playwright-mcp/

# 备份快照输出（app.snapshot.directory 默认 ./snapshots）
snapshots/

# 本地配置与密钥
.env
.env.*
*.pem
*.key
*.p12
*.jks
.npmrc
application-local.yml

# 操作系统
.DS_Store
Thumbs.db
